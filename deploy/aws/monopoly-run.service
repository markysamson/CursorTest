[Unit]
Description=Monopoly Run (Next.js)
After=network.target

[Service]
Type=simple
User=monopoly
Group=monopoly
WorkingDirectory=/opt/monopoly-run
EnvironmentFile=/var/lib/monopoly-run/.env
Environment=MONOPOLY_BIND_HOST=0.0.0.0
Environment=PORT=3000
ExecStart=/usr/bin/bash /opt/monopoly-run/scripts/start-prod.sh
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
