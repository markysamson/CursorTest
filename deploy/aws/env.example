# Copy to /var/lib/monopoly-run/.env (see deploy/aws/README.md)

MONOPOLY_DATA_DIR="/var/lib/monopoly-run"

AUTH_SECRET="replace-with-openssl-rand-hex-32"
ADMIN_PASSWORD="replace-with-strong-password"

HOSTNAME=0.0.0.0
PORT=3000

# Use HTTPS via Caddy — do not set COOKIE_SECURE=false on the public internet.
