# Copy to /var/lib/monopoly-run/.env and edit (see deploy/aws/README.md).
# App code path on EC2: /opt/monopoly-run/CursorTest
# AUTH_SECRET: output of `openssl rand -hex 32`
# ADMIN_PASSWORD: sign-in password for /admin

MONOPOLY_DATA_DIR="/var/lib/monopoly-run"

AUTH_SECRET="paste-openssl-rand-hex-32-here"
ADMIN_PASSWORD="choose-a-strong-manager-password"

# Do not use HOSTNAME= — Ubuntu overwrites it with the machine name (ip-172-…).
MONOPOLY_BIND_HOST=0.0.0.0
PORT=3000

# Use HTTPS via Caddy — do not set COOKIE_SECURE=false on the public internet.
