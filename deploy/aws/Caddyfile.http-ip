# Quick test ONLY — use http://YOUR_EC2_PUBLIC_IP (port 80, not 443).
# Phone GPS may not work without HTTPS; switch to Caddyfile when you have a domain.
#
# sudo cp /opt/monopoly-run/deploy/aws/Caddyfile.http-ip /etc/caddy/Caddyfile
# sudo caddy validate --config /etc/caddy/Caddyfile
# sudo systemctl restart caddy

:80 {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}
