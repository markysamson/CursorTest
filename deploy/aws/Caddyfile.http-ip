# No domain: use http://YOUR_EC2_PUBLIC_IP (port 80 only — no 443).
# For phone GPS use Caddyfile.nip-io (free https://YOUR.IP.nip.io) or your own domain.
#
# sudo cp /opt/monopoly-run/CursorTest/deploy/aws/Caddyfile.http-ip /etc/caddy/Caddyfile
# sudo caddy validate --config /etc/caddy/Caddyfile
# sudo systemctl restart caddy

:80 {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}
