# Local dev (SQLite file in the repo)
DATABASE_URL="file:./dev.db"

# Production on EC2/VPS: set a persistent directory instead of
# DATABASE_URL — the app uses data.db and uploads/ inside this folder.
# MONOPOLY_DATA_DIR="/var/lib/monopoly-run"

AUTH_SECRET="change-me-to-a-long-random-string"
ADMIN_PASSWORD="monopoly-admin"

# Listen (systemd/Caddy in front on 443)
# PORT=3000
# HOSTNAME=0.0.0.0
